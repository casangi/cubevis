# ---------------------------------------------------------------------------
# Parameter validator
# ---------------------------------------------------------------------------
# Checks each user-supplied argument against the type annotation from
# {{ class_name }}.__init__ and raises ValueError for obviously wrong types.
# The check is intentionally permissive: None is accepted for any Optional[X]
# or X | None parameter; complex/unknown annotation strings pass through
# unchecked.  This catches gross misuse (e.g. passing an int where a str is
# required) before the task is dispatched.

def _validate_params(
{%- for arg in methods['__init__'].args if not arg.is_self and not arg.is_star and not arg.is_layer %}
        {{ arg.name }},
{%- endfor %}
):
    import re as _re

    _type_map = {
{%- for arg in methods['__init__'].args if not arg.is_self and not arg.is_star and not arg.is_layer %}
{%- if arg.validator_override %}
        '{{ arg.name }}': '{{ arg.validator_override }}',   # override
{%- else %}
        '{{ arg.name }}': '{{ arg.type }}',
{%- endif %}
{%- endfor %}
    }

    _simple = {
        'str': str, 'int': int, 'float': float,
        'bool': bool, 'tuple': tuple, 'list': list,
    }

    def _check(name, value, ann):
        if not ann:
            return
        # Normalise Optional[X] and X | None to (nullable=True, inner=X)
        nullable = False
        m = _re.match(r'Optional\[(.+)\]', ann)
        if m:
            nullable = True
            ann = m.group(1)
        elif '|' in ann:
            parts = [p.strip() for p in ann.split('|')]
            if 'None' in parts:
                nullable = True
                parts = [p for p in parts if p != 'None']
            ann = '|'.join(parts)
        if nullable and value is None:
            return
        # Parenthesised override expression, e.g. "(tuple, list)"
        if ann.startswith('(') and ann.endswith(')'):
            py_types = tuple(
                _simple[t.strip()]
                for t in ann[1:-1].split(',')
                if t.strip() in _simple
            )
            if py_types and not isinstance(value, py_types):
                type_names = ' or '.join(t.__name__ for t in py_types)
                raise ValueError(
                    f"'{{ task_name }}' parameter '{name}': expected {type_names}, "
                    f"got {type(value).__name__} ({value!r})"
                )
            return
        # Union of remaining branches after None-stripping
        if '|' in ann:
            py_types = tuple(
                _simple[_re.match(r'(\w+)', b.strip()).group(1)]
                for b in ann.split('|')
                if _re.match(r'(\w+)', b.strip())
                and _re.match(r'(\w+)', b.strip()).group(1) in _simple
            )
            if py_types and not isinstance(value, py_types):
                type_names = ' or '.join(t.__name__ for t in py_types)
                raise ValueError(
                    f"'{{ task_name }}' parameter '{name}': expected {type_names}, "
                    f"got {type(value).__name__} ({value!r})"
                )
            return
        # Single type — strip parameterisation, e.g. tuple[float, float] → tuple
        base = _re.match(r'(\w+)', ann)
        if base:
            py_type = _simple.get(base.group(1))
            if py_type is not None and not isinstance(value, py_type):
                raise ValueError(
                    f"'{{ task_name }}' parameter '{name}': expected {py_type.__name__}, "
                    f"got {type(value).__name__} ({value!r})"
                )

{%- for arg in methods['__init__'].args if not arg.is_self and not arg.is_star and not arg.is_layer %}
    _check('{{ arg.name }}', {{ arg.name }}, _type_map['{{ arg.name }}'])
{%- endfor %}


def _{{ task_name }}_t(
        {{ methods['__init__'].arguments | strip_self | strip_layer | wrap_args(8) }},
):
