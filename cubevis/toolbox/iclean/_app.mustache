'''The interactive clean applications: ``InteractiveClean`` (a browser tab,
``iclean``) and ``InteractiveCleanNotebook`` (a Jupyter cell,
``iclean.notebook``), which differs only in how it is displayed.

GENERATED by ``scripts/expand_templates`` from ``_app.mustache`` with
tclean's task XML (the parameters, their defaults and documentation): edit
the template, not ``_app.py``.  (Until 2026-11-05 these were two templates,
``cubevis/private/apps/_interactiveclean{,notebook}.mustache``.)'''

from uuid import uuid4

from cubevis.utils import MutualExclusionManager
from cubevis.bokeh.models import Showable
from cubevis.imaging import LocalImagingSession
from cubevis import exe
from ._ui import InteractiveCleanUI

class InteractiveClean:
    r'''InteractiveClean(...) implements interactive clean using Bokeh
    {{docstring}}
    '''

    def __init__( self, vis, imagename{{# initParams}}, {{name}}={{default}}{{/ initParams}}, iclean_backend="PROD", kernel_name=None ):
        ###
        ### iclean_backend can be used to select alternate backends for interactive clean. This could be used
        ### to enable a backend with extended features or it could be used to select a stub backend designed
        ### for testing
        ###
        self._args = {{forwDict}}
        ###
        ### The imaging layer (cubevis.imaging): the imager -- casatasks' gclean, or the module
        ### _gclean_NAME that iclean_backend names -- and the images of each field
        ###
        ### kernel_name: the imager and its images run on that Jupyter kernel (a kernelspec
        ### name; e.g. one cubevis setup made for a cluster node), with vis and imagename
        ### paths on its host; the GUI runs here (cubevis.imaging.RemoteImagingSession)
        ###
        if kernel_name:
            from cubevis.imaging import RemoteImagingSession
            self._session = RemoteImagingSession( self._args, kernel_name, iclean_backend=iclean_backend )
        else:
            self._session = LocalImagingSession.from_args( self._args, iclean_backend )
        self._gclean = self._session.deconvolver
        self._gclean_paths = self._session.image_products( )

        self._ui = InteractiveCleanUI(self._session, self._args)

    def __call__( self ):
        '''Display GUI and process events until the user stops the application.

        Example:
            Create ``iclean`` object and display::

                print( "Result: %s" %
                       iclean( vis='refim_point_withline.ms', imagename='test', imsize=512,
                               cell='12.0arcsec', specmode='cube',
                               interpolation='nearest', ... )( ) )
        '''
        self._id = uuid4( )
        context = exe.Context( exe.Mode.SYNC )
        bokeh_ui, exec_task = self._ui( context, self._id )
        bokeh_ui.show( )
        return context.execute( exec_task, self._id )


class DisplayContext:
    def __init__(self, exclusion_manager):
        self.exclusion_manager = exclusion_manager
        self._custom_show_called = False

    def on_show(self):
        self._custom_show_called = True
        self.exclusion_manager.set_mode('cell-custom-show')

    def on_to_serializable(self):
        # Only set mode if custom_show hasn't been called
        if not self._custom_show_called:
            self.exclusion_manager.set_mode('cell-bokeh-show')
        # If custom_show was called, we're already in 'cell-custom-show' mode
        # and don't need to do anything

class InteractiveCleanNotebook( InteractiveClean ):
    r'''InteractiveCleanNotebook(...) implements interactive clean using Bokeh
    {{docstring}}
    '''

    def __init__( self, *args, **kwargs ):
        super( ).__init__( *args, **kwargs )
        self._future = None

    def get_future(self):
        if self._future is None:
            raise RuntimeError( "interactive clean app has not been launched yet" )
        return self._future

    def __call__( self ):
        '''Display GUI and process events until the user stops the application.

        Example:
            Create ``iclean`` object and display::

                print( "Result: %s" %
                       iclean( vis='refim_point_withline.ms', imagename='test', imsize=512,
                               cell='12.0arcsec', specmode='cube',
                               interpolation='nearest', ... )( ) )
        '''
        ###
        ### Output notebook is implied.
        ###
        from bokeh.io.state import curstate
        state = curstate()
        if not state.notebook:
            from bokeh.io import output_notebook
            output_notebook( )

        self._id = uuid4( )
        context = exe.Context( exe.Mode.THREAD )
        bokeh_ui, exec_task = self._ui( context, self._id )

        def startup( ):
            self._future = context.execute( exec_task, self._id )

        display_ctx = DisplayContext(
            ###
            ### The expectation is that the "tab" option will not be used in practice because that interface is
            ### separate from the `iclean.notebook(...)` interface which is implemented here. In other words,
            ### the user cannot create a interactive clean instance in a notebook tab using the same object
            ### that is returned for display within a Jupyter notebook. InteractiveClean.__call__ would be
            ### the place that sets "tab" while InteractiveCleanNotebook (via DisplayContext above) is the
            ### place that sets "cell-bokeh-show" and "cell-custom-show".
            ###
            MutualExclusionManager(
                name="interactive clean",
                valid_modes={
                    "tab":              "❌ Cannot use iclean task display:\n\n" \
                                        "Reason: bokeh.plotting.show() or iclean show method has already been\n" \
                                        "        used for display of this class. Mixing display methods within\n" \
                                        "        a single notebook corrupts Bokeh display within the notebook\n",
                    "cell-bokeh-show":  "❌ Cannot use bokeh.plotting.show() display method:\n\n" \
                                        "Reason: iclean show or task method has already been used for display\n" \
                                        "        of this class. Mixing display methods within a single notebook\n" \
                                        "        corrupts Bokeh display within the notebook\n",
                    "cell-custom-show": "❌ Cannot use iclean show method:\n\n" \
                                        "Reason: bokeh.plotting.show() or task has already been used for display\n" \
                                        "        of this class. Mixing display methods within a single notebook\n" \
                                        "        corrupts Bokeh display within the notebook\n",
                }
            )
        )

        ### name is used in summary output of the Showable
        showed = Showable(
            bokeh_ui,
            startup,
            self.get_future,
            name="iclean-jpy",
            display_context=display_ctx
        )
        return showed
