    def __validate_(self, name, value):
        """Lightweight type-annotation-based validator.

        Returns True when *value* is consistent with the type annotation
        of parameter *name* in ``{{ class_name }}.__init__``.  Used by
        ``inp()`` to drive colorization (blue = changed from default,
        red = invalid, no color = at default).

        The check is intentionally permissive: it accepts ``None`` for any
        ``Optional[...]`` parameter and otherwise does a simple
        ``isinstance`` check on the base type.  Complex union types fall
        back to ``True`` so that a valid value is never falsely rejected.

        Where ``validator_overrides`` were specified in ``project_layers.yaml``,
        the overriding type expression is used instead of the annotation.
        """
        # Type map: annotation string (or override) per parameter name.
        # Override entries are set explicitly via validator_overrides in YAML.
        _type_map = {
{%- for arg in methods['__init__'].args if not arg.is_self and not arg.is_star and not arg.is_layer %}
{%- if arg.validator_override %}
            '{{ arg.name }}': '{{ arg.validator_override }}',   # override
{%- else %}
            '{{ arg.name }}': '{{ arg.type }}',
{%- endif %}
{%- endfor %}
        }
        ann = _type_map.get(name, '')
        if not ann:
            return True
        import re as _re
        # Normalise both Optional[X] and "X | None" / "None | X" to just X,
        # accepting None for either form.
        m = _re.match(r'Optional\[(.+)\]', ann)
        if m:
            if value is None:
                return True
            ann = m.group(1)
        elif '|' in ann:
            parts = [p.strip() for p in ann.split('|')]
            if 'None' in parts:
                if value is None:
                    return True
                parts = [p for p in parts if p != 'None']
            # Flatten remaining union — accept if value matches any branch.
            # Parameterised generics like tuple[float, float] are reduced to
            # their base type (tuple) for the isinstance check.
            ann = '|'.join(parts)
        # Map annotation strings to Python types.  Parameterised generics
        # (e.g. "tuple[float, float]") are matched by their base name.
        # Parenthesised override expressions (e.g. "(tuple, list)") are also
        # handled here so validator_overrides still work.
        _simple = {
            'str': str, 'int': int, 'float': float,
            'bool': bool, 'tuple': tuple, 'list': list,
        }
        if ann.startswith('(') and ann.endswith(')'):
            py_types = tuple(
                _simple[t.strip()]
                for t in ann[1:-1].split(',')
                if t.strip() in _simple
            )
            return isinstance(value, py_types) if py_types else True
        if '|' in ann:
            # Remaining union after None-stripping: accept if any branch matches
            py_types = tuple(
                _simple[_re.match(r'(\w+)', b.strip()).group(1)]
                for b in ann.split('|')
                if _re.match(r'(\w+)', b.strip()) and
                   _re.match(r'(\w+)', b.strip()).group(1) in _simple
            )
            return isinstance(value, py_types) if py_types else True
        # Single type — strip any parameterisation, e.g. tuple[float, float] → tuple
        base = _re.match(r'(\w+)', ann)
        if base:
            py_type = _simple.get(base.group(1))
            if py_type is not None:
                return isinstance(value, py_type)
        # Unknown / complex type — accept
        return True

    def __do_inp_output(self, param_prefix, description_str, formatting_chars):
        out = self.__stdout or sys.stdout
        description = description_str.split()
        prefix_width = 23 + 23 + 4
        output = []
        addon = ''
        first_addon = True
        if len(description) == 0:
            out.write(param_prefix + " #\n")
            return
        while len(description) > 0:
            if len(output) == 0:
                if len(param_prefix) - formatting_chars > prefix_width - 1:
                    output.append(param_prefix)
                    continue
                addon = param_prefix + ' #'
                first_addon = True
                addon_formatting = formatting_chars
            else:
                addon = (' ' * prefix_width) + '#'
                first_addon = False
                addon_formatting = 0
            if len(addon + description[0]) - addon_formatting + 1 > self.term_width:
                if first_addon:
                    output.append(addon)
                break
            while len(description) > 0:
                if len(addon + description[0]) - addon_formatting + 1 > self.term_width:
                    break
                addon = addon + ' ' + description[0]
                description.pop(0)
            output.append(addon)
        out.write('\n'.join(output) + '\n')

